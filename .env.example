# Configurações da API
PORT=3000

# API Key para autenticação
# Gere uma chave segura para uso em produção
API_KEY=sua-api-key-secreta-aqui

# Configurações de Cache (em segundos)
CACHE_TTL=120

# URL da API de cotações
EXCHANGE_API_URL=https://economia.awesomeapi.com.br/json/last

# Assistente em linguagem natural (opcional)
# Sem a chave, o resto da API funciona e /api/assistant/ask responde 503.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5
# low | medium | high. Deixe vazio em modelos que não aceitam effort (ex.: claude-haiku-4-5)
ASSISTANT_EFFORT=low
# off desliga o fallback do servidor quando o modelo recusa por política
ASSISTANT_FALLBACKS=default
